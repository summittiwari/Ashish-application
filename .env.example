# Local deployment is bound to 127.0.0.1. Set a long random key before exposing it.
AUTH_TOKEN=
# Required only by compose.distributed.yaml; use URL-safe alphanumeric secrets.
POSTGRES_PASSWORD=
MAX_UPLOAD_BYTES=1073741824
PAGE_CONCURRENCY=2
WORKER_MEMORY_MB=4096
# Local worker automatically expires terminal jobs and unreferenced documents after 30 days.
# Set 0 to retain indefinitely. S3 archives have independent bucket lifecycle rules.
RETENTION_DAYS=30
INSTALL_OCR=0
SURYA_INFERENCE_URL=
# Optional distributed archive; standard AWS credentials or workload identity.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_PREFIX=pdf-sentinel
S3_SSE=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
